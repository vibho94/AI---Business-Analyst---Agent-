      ],
      "id": "27d2a48f-f2c1-40dc-866c-c3698ef64677",
      "name": "FRD Generator"
    },
    {
      "parameters": {
        "jsCode": "const frd = $('FRD Generator').first().json.output;\nconst story = $('User Story Reviewer').first().json.output;\nconst testCases = $('Test Case Generator').first().json.output;\n\nreturn [{\n  json: {\n    emailBody:\n`FUNCTIONAL REQUIREMENT DOCUMENT\n\n${frd}\n\n==================================================\n\nUSER STORY\n\n${story}\n\n==================================================\n\nTEST CASES\n\n${testCases}`\n  }\n}];"
      },
