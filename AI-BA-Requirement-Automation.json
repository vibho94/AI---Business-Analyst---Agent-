      "parameters": {
        "promptType": "define",
        "text": "=Generate a Detailed FRD basis on the given :-\n{{ $json['Requirement Title'] }}\n{{ $json.Description }}",
        "options": {
          "systemMessage": "You are a Senior Business Analyst.\n\nGenerate a Functional Requirement Document (FRD).\n\nOutput Format:\n\n1. Requirement Title\n2. Business Requirement\n3. Functional Overview\n4. Scope\n5. User Roles\n6. Functional Flow\n7. Process Steps\n8. Business Rules\n9. Validations\n10. API / Integration Impact\n\n\nUse bullet points.\n\nDo not generate user stories."
        }
      },
